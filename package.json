{
    "name": "pomodoro-timer",
    "version": "1.0.0",
    "description": "A modern Pomodoro Timer web application with task management and productivity features",
    "main": "index.js",
    "type": "module",
    "scripts": {
        "dev": "http-server -p 3000 -o",
        "lint": "eslint index.js --fix",
        "format": "prettier --write \"*.{js,html,css,scss,json}\"",
        "serve": "http-server -p 8080",
        "check": "pnpm run lint && pnpm run format",
        "validate": "./validate-simple.sh",
        "test": "node --test \"tests/**/*.test.js\"",
        "test:e2e": "playwright test"
    },
    "keywords": [
        "pomodoro",
        "timer",
        "productivity",
        "task-management",
        "vue"
    ],
    "packageManager": "pnpm@10.28.0",
    "author": "Kouni",
    "license": "MIT",
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@playwright/test": "1.64.1",
        "axe-core": "4.14.0",
        "eslint": "^10.14.0",
        "eslint-config-prettier": "^10.1.8",
        "globals": "^17.14.0",
        "http-server": "^14.1.1",
        "prettier": "^3.9.10",
        "vue": "3.5.44"
    },
    "browserslist": [
        "> 1%",
        "last 2 versions",
        "not dead",
        "not ie 11"
    ],
    "engines": {
        "node": ">=26.13.0 <27",
        "npm": ">=8.0.0"
    }
}
