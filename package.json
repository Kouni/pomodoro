{
    "name": "pomodoro-timer",
    "version": "1.0.0",
    "private": true,
    "description": "A modern Pomodoro Timer web application with task management and productivity features",
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "vite build",
        "preview": "vite preview --host 127.0.0.1 --port 8080 --strictPort",
        "lint": "eslint src tests public/sw-notify.js eslint.config.js playwright.config.js vite.config.js",
        "format": "prettier --write .",
        "validate": "pnpm lint && pnpm exec prettier --check . && pnpm test && pnpm build",
        "test": "node --test \"tests/unit/**/*.test.js\"",
        "test:e2e": "playwright test"
    },
    "keywords": [
        "pomodoro",
        "timer",
        "productivity",
        "task-management",
        "vue"
    ],
    "packageManager": "pnpm@10.28.0",
    "author": "Kouni",
    "license": "MIT",
    "homepage": "https://tomato.kouni.io",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/Kouni/pomodoro.git"
    },
    "bugs": {
        "url": "https://github.com/Kouni/pomodoro/issues"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@playwright/test": "1.65.0",
        "@vitejs/plugin-vue": "6.0.10",
        "axe-core": "4.14.0",
        "eslint": "^10.14.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-vue": "10.12.0",
        "globals": "^17.14.0",
        "prettier": "^3.9.10",
        "sass": "1.108.1",
        "vite": "8.3.6",
        "vite-plugin-pwa": "2.0.0",
        "workbox-window": "7.4.1"
    },
    "browserslist": [
        "> 1%",
        "last 2 versions",
        "not dead",
        "not ie 11"
    ],
    "engines": {
        "node": ">=26.13.0 <27",
        "pnpm": ">=10"
    },
    "pnpm": {
        "overrides": {
            "eslint>minimatch": "^11.0.1",
            "@eslint/config-array>minimatch": "^11.0.1",
            "filelist>minimatch": "^11.0.1",
            "workbox-build>glob": "^14.0.2"
        }
    },
    "dependencies": {
        "progressbar.js": "1.1.1",
        "vue": "3.5.45"
    }
}
